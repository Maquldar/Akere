{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "allowJs": false,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@messages/*": [
        "./messages/*"
      ]
    }
  },
  "include": [
    "*.mjs",
    "*.ts",
    ".next-3103/types/**/*.ts",
    ".next-3104/types/**/*.ts",
    ".next-3106/types/**/*.ts",
    ".next/types/**/*.ts",
    "e2e/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-3105/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
