# Copy to apps/api/.env  (docker-compose sets these for you)
DATABASE_URL=postgresql://akere:akere@localhost:5432/akere
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
# Shows one-click demo accounts on the login page. Never enable in production.
DEMO_MODE=true
# 32 bytes hex, encrypts per-user signing keys. Generate: openssl rand -hex 32
SIGNING_MASTER_KEY=
STORAGE_DRIVER=local            # local | s3
STORAGE_DIR=./data/files
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=akere
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# SMTP_URL=smtp://localhost:1025   # Mailpit in docker-compose
MAIL_FROM=Akere HR <no-reply@akere.local>
SUPPORT_EMAIL=support@akere.local
JOBS_ENABLED=true
LOG_LEVEL=info
